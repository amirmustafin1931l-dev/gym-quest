# Скопируй в .env и заполни. Без этих значений вкладка «Банда» работает в режиме заглушки.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Имя бота и короткое имя Mini App из BotFather — для ссылок-приглашений t.me/<бот>/<app>
VITE_BOT_NAME=gymquest_bot
VITE_APP_NAME=app
# Только для отладки в обычном браузере (должен совпадать с секретом DEV_LOGIN_SECRET функции tg-auth)
# VITE_DEV_LOGIN_SECRET=
# Демо-режим банды с выдуманными игроками, без сервера
# VITE_SOCIAL_MOCK=1
